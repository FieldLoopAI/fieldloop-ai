# Copy this to .env.local and fill in real values. Vite only exposes
# variables prefixed with VITE_ to the browser bundle — never put the
# Supabase service-role key here, only the anon key.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL the frontend calls for every Lambda operation, e.g. the invoke
# URL of a shared API Gateway HTTP API in front of the Lambda functions
# under backend/functions/. Each function is expected to be reachable at
# `${VITE_API_BASE_URL}/<function-name>` (see src/shared/services/api.js).
VITE_API_BASE_URL=
